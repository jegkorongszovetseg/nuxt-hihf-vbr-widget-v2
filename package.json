{
  "name": "@mjsz-vbr-elements/nuxt",
  "version": "0.1.1",
  "description": "Nuxt module for Data visualization for MJSZ VBR",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build prepare && nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build prepare && nuxt-module-build build --stub && nuxi prepare playground",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && pnpm publish --access public && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@mjsz-vbr-elements/core": "^2.49.2",
    "@nuxt/kit": "^4.6.2",
    "defu": "^6.1.3",
    "pkg-types": "^1.0.3"
  },
  "devDependencies": {
    "@nuxt/cli": "^3.37.0",
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^24.0.0",
    "changelogen": "^0.5.5",
    "eslint": "^10.4.0",
    "nuxt": "4.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.2",
    "vue": "^3.5.44"
  }
}